{
    "extends": "@repo/typescript-config/nextjs.json",
    "compilerOptions": {
        "lib": ["ES2020", "dom", "dom.iterable"],
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        },
        "plugins": [
            {
                "name": "next"
            }
        ],
        "resolveJsonModule": true
    },
    "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
    "exclude": ["node_modules"]
}
