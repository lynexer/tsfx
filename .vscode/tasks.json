{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "watch-extension",
            "type": "shell",
            "command": "pnpm",
            "args": ["run", "watch"],
            "options": {
                "cwd": "${workspaceFolder}/packages/extension"
            },
            "problemMatcher": {
                "owner": "tsup",
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "CJS Build start",
                    "endsPattern": "CJS ⚡️ Build success"
                }
            },
            "isBackground": true,
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}