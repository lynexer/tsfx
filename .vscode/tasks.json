{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "watch-extension",
            "type": "shell",
            "command": "pnpm",
            "args": ["run", "watch"],
            "options": {
                "cwd": "${workspaceFolder}/packages/vscode"
            },
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
