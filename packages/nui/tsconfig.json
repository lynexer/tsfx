{
    "extends": "@repo/typescript-config/react-library.json",
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "bundler",
        "emitDecoratorMetadata": false,
        "outDir": "dist",
        "rootDir": "src",
        "types": ["@types/node", "@types/react", "@types/react-dom"],
        "noEmit": true,
        "paths": {
            "@/*": ["./src/*"]
        },
        "lib": ["DOM"]
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist", ".turbo"]
}
