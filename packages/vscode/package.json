{
    "name": "@tsfx/vscode",
    "displayName": "TSFX Extension",
    "description": "VSCode extension for TSFX",
    "version": "0.0.1",
    "publisher": "tsfx",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": ["Programming Languages", "Linters"],
    "main": "./dist/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "teal",
                "aliases": ["Teal", "teal"],
                "extensions": [".tl"],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "teal",
                "scopeName": "source.teal",
                "path": "./syntaxes/teal.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "teal-fivem.checkFile",
                "title": "Teal: Check Current File"
            },
            {
                "command": "teal-fivem.showVersion",
                "title": "Teal: Show Compiler Version"
            }
        ],
        "configuration": {
            "title": "Teal for FiveM",
            "properties": {
                "teal-fivem.checkOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Run tl check automatically when a .tl file is saved."
                },
                "teal-fivem.checkOnType": {
                    "type": "boolean",
                    "default": true,
                    "description": "Run tl check as you type (debounced). Requires saving to disk first to take effect."
                },
                "teal-fivem.injectFiveMTypes": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically inject FiveM/cfxlua type definitions into the type checker."
                },
                "teal-fivem.tlConfigPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to a tlconfig.lua file. Defaults to workspace root if empty."
                },
                "teal-fivem.extraIncludeDirs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Additional directories to add to the Teal include path."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "pnpm run download-binaries && pnpm run download-lsp && pnpm run build",
        "build": "tsup",
        "watch": "tsup --watch",
        "package": "vsce package --no-dependencies",
        "lint": "biome check --write .",
        "download-binaries": "tsx --tsconfig tsconfig.scripts.json scripts/download-binaries.ts",
        "download-lsp": "tsx --tsconfig tsconfig.scripts.json scripts/download-lsp.ts",
        "gen-natives": "tsx --tsconfig tsconfig.scripts.json scripts/gen-natives.ts"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.15",
        "@citizenfx/client": "2.0.29753-1",
        "@citizenfx/server": "2.0.29753-1",
        "@repo/biome-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/node": "^22.19.19",
        "@types/vscode": "^1.96.0",
        "@vscode/vsce": "^3.9.1",
        "node-fetch": "^3.3.2",
        "tsup": "^8.5.1",
        "tsx": "^4.22.4",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    }
}
