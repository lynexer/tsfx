{
    "name": "@tlfx/compiler",
    "version": "0.0.6",
    "description": "Teal language compiler wrapper for FiveM (cfxlua) projects",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "tlfx-compiler": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsup",
        "lint": "biome check --write .",
        "postinstall": "node dist/install.js",
        "prepublishOnly": "pnpm build"
    },
    "files": ["dist", "bin"],
    "devDependencies": {
        "@biomejs/biome": "^2.4.15",
        "@repo/biome-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/node": "^22.15.21",
        "tsup": "^8.5.0",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "node-fetch": "^3.3.2"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
